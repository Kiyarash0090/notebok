# APP_URL: The URL where this applet is hosted (used for links & API endpoints).
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000; Railway sets this automatically).
# PORT=3000

# DATA_DIR: Persistent data directory path (e.g. /app/data when using a Railway Volume).
# Railway also sets RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is attached.
# DATA_DIR=/app/data
